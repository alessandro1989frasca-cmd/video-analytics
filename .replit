modules = ["nodejs-20", "swift-5.8", "web", "python-base-3.13"]

[nix]
channel = "stable-25_05"

[agent]
expertMode = true

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Player Demo"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Collector API"

[[workflows.workflow]]
name = "Player Demo"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "PORT=5000 node player-demo/server.js"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow]]
name = "Collector API"
author = "agent"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd backend && npm ci --no-audit --no-fund && npm run build && NODE_ENV=production npm start"
waitForPort = 3000

[[ports]]
localPort = 3000
externalPort = 3000

[[ports]]
localPort = 5000
externalPort = 80

[userenv]

[userenv.shared]
CLICKHOUSE_HOST = "https://i9vf91kzz1.germanywestcentral.azure.clickhouse.cloud:8443"
