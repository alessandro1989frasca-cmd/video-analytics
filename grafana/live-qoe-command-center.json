{
  "__inputs": [
    {
      "name": "DS_CLICKHOUSE",
      "label": "ClickHouse Analytics",
      "type": "datasource",
      "pluginId": "grafana-clickhouse-datasource",
      "pluginName": "ClickHouse"
    }
  ],
  "__requires": [
    {
      "type": "grafana",
      "id": "grafana",
      "name": "Grafana",
      "version": "10.0.0"
    },
    {
      "type": "datasource",
      "id": "grafana-clickhouse-datasource",
      "name": "ClickHouse",
      "version": "4.0.0"
    }
  ],
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "editable": true,
  "graphTooltip": 1,
  "links": [],
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Live viewers",
      "description": "Distinct sessions with heartbeat activity in the last two minutes.",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "${DS_CLICKHOUSE}"
      },
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "gray",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          },
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "center",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "database": "analytics",
          "format": "table",
          "rawSql": "SELECT uniqMerge(viewers_state) AS live_viewers FROM analytics_concurrent_viewers WHERE content_type = 'live' AND minute >= now() - INTERVAL 2 MINUTE AND ('${content_id}' = 'ALL' OR content_id = '${content_id}')"
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Avg startup",
      "description": "Average time from play request to first frame for completed live sessions.",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "${DS_CLICKHOUSE}"
      },
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 4,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 3000
              },
              {
                "color": "red",
                "value": 8000
              }
            ]
          },
          "unit": "ms"
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "center",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "database": "analytics",
          "format": "table",
          "rawSql": "SELECT coalesce(round(avg(startup_time_ms), 0), 0) AS avg_startup_ms FROM analytics_sessions WHERE session_date BETWEEN toDate($__fromTime) AND toDate($__toTime) AND content_type = 'live' AND ('${content_id}' = 'ALL' OR content_id = '${content_id}')"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Rebuffer ratio",
      "description": "Total rebuffer time divided by watch time.",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "${DS_CLICKHOUSE}"
      },
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 8,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 1
              },
              {
                "color": "red",
                "value": 3
              }
            ]
          },
          "unit": "percent"
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "center",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "database": "analytics",
          "format": "table",
          "rawSql": "SELECT coalesce(round(100 * sum(rebuffer_time_s) / nullIf(sum(watch_time_s), 0), 3), 0) AS rebuffer_ratio_pct FROM analytics_sessions WHERE session_date BETWEEN toDate($__fromTime) AND toDate($__toTime) AND content_type = 'live' AND ('${content_id}' = 'ALL' OR content_id = '${content_id}')"
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Errors",
      "description": "Error events in the selected time range.",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "${DS_CLICKHOUSE}"
      },
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 12,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 1
              },
              {
                "color": "red",
                "value": 5
              }
            ]
          },
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "center",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "database": "analytics",
          "format": "table",
          "rawSql": "SELECT count() AS errors FROM analytics_errors WHERE timestamp BETWEEN toUnixTimestamp($__fromTime) * 1000 AND toUnixTimestamp($__toTime) * 1000 AND ('${content_id}' = 'ALL' OR content_id = '${content_id}')"
        }
      ]
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Avg bitrate",
      "description": "Average current player bitrate from recent heartbeats.",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "${DS_CLICKHOUSE}"
      },
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 16,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "continuous-GrYlRd"
          },
          "unit": "Mbps"
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "center",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "database": "analytics",
          "format": "table",
          "rawSql": "SELECT coalesce(round(avg(current_bitrate_kbps) / 1000, 3), 0) AS avg_bitrate_mbps FROM analytics_heartbeats WHERE event_minute >= now() - INTERVAL 5 MINUTE AND ('${content_id}' = 'ALL' OR content_id = '${content_id}')"
        }
      ]
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Live latency",
      "description": "Average live latency from recent player samples.",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "${DS_CLICKHOUSE}"
      },
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 20,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 10
              },
              {
                "color": "red",
                "value": 20
              }
            ]
          },
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "center",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "database": "analytics",
          "format": "table",
          "rawSql": "SELECT coalesce(round(avg(JSONExtractFloat(payload, 'latency_s')), 2), 0) AS avg_latency_s FROM analytics_events WHERE event_type = 'LIVE_LATENCY' AND timestamp BETWEEN toUnixTimestamp($__fromTime) * 1000 AND toUnixTimestamp($__toTime) * 1000 AND content_type = 'live' AND ('${content_id}' = 'ALL' OR content_id = '${content_id}')"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Live viewers by channel",
      "description": "Current viewer activity by selected content channel.",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "${DS_CLICKHOUSE}"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 5
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "min": 0,
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "database": "analytics",
          "format": "time_series",
          "rawSql": "SELECT minute AS time, content_id, uniqMerge(viewers_state) AS viewers FROM analytics_concurrent_viewers WHERE content_type = 'live' AND minute BETWEEN $__fromTime AND $__toTime AND ('${content_id}' = 'ALL' OR content_id = '${content_id}') GROUP BY minute, content_id ORDER BY minute"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Bitrate and bandwidth",
      "description": "Player bitrate and bandwidth estimate, displayed in Mbps.",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "${DS_CLICKHOUSE}"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 5
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "unit": "Mbps"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "database": "analytics",
          "format": "time_series",
          "rawSql": "SELECT event_minute AS time, round(avg(current_bitrate_kbps) / 1000, 3) AS bitrate_mbps, round(avg(bandwidth_estimate_kbps) / 1000, 3) AS bandwidth_mbps FROM analytics_heartbeats WHERE event_minute BETWEEN $__fromTime AND $__toTime AND ('${content_id}' = 'ALL' OR content_id = '${content_id}') GROUP BY event_minute ORDER BY event_minute"
        }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Startup time",
      "description": "Average and p95 startup time for live sessions.",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "${DS_CLICKHOUSE}"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 14
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "unit": "ms"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "database": "analytics",
          "format": "time_series",
          "rawSql": "SELECT toStartOfMinute(toDateTime(intDiv(timestamp, 1000))) AS time, round(avg(JSONExtractInt(payload, 'join_time_ms')), 0) AS avg_startup_ms, quantile(0.95)(JSONExtractInt(payload, 'join_time_ms')) AS p95_startup_ms FROM analytics_events WHERE event_type = 'JOIN_TIME' AND timestamp BETWEEN toUnixTimestamp($__fromTime) * 1000 AND toUnixTimestamp($__toTime) * 1000 AND content_type = 'live' AND ('${content_id}' = 'ALL' OR content_id = '${content_id}') GROUP BY time ORDER BY time"
        }
      ]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Live latency",
      "description": "Average and p95 live latency from player measurements.",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "${DS_CLICKHOUSE}"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 14
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "database": "analytics",
          "format": "time_series",
          "rawSql": "SELECT toStartOfMinute(toDateTime(intDiv(timestamp, 1000))) AS time, round(avg(JSONExtractFloat(payload, 'latency_s')), 2) AS avg_latency_s, round(quantile(0.95)(JSONExtractFloat(payload, 'latency_s')), 2) AS p95_latency_s FROM analytics_events WHERE event_type = 'LIVE_LATENCY' AND timestamp BETWEEN toUnixTimestamp($__fromTime) * 1000 AND toUnixTimestamp($__toTime) * 1000 AND content_type = 'live' AND ('${content_id}' = 'ALL' OR content_id = '${content_id}') GROUP BY time ORDER BY time"
        }
      ]
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Buffer health",
      "description": "Average buffer length and low-buffer p10 in seconds.",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "${DS_CLICKHOUSE}"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 23
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "database": "analytics",
          "format": "time_series",
          "rawSql": "SELECT event_minute AS time, round(avg(buffer_length_s), 2) AS average_buffer_s, round(quantile(0.10)(buffer_length_s), 2) AS p10_buffer_s FROM analytics_heartbeats WHERE event_minute BETWEEN $__fromTime AND $__toTime AND ('${content_id}' = 'ALL' OR content_id = '${content_id}') GROUP BY event_minute ORDER BY event_minute"
        }
      ]
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Errors over time",
      "description": "Errors grouped by error source and code.",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "${DS_CLICKHOUSE}"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 23
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "min": 0,
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "database": "analytics",
          "format": "time_series",
          "rawSql": "SELECT toStartOfMinute(toDateTime(intDiv(timestamp, 1000))) AS time, concat(error_source, ': ', error_code) AS error, count() AS errors FROM analytics_errors WHERE timestamp BETWEEN toUnixTimestamp($__fromTime) * 1000 AND toUnixTimestamp($__toTime) * 1000 AND ('${content_id}' = 'ALL' OR content_id = '${content_id}') GROUP BY time, error ORDER BY time"
        }
      ]
    },
    {
      "id": 13,
      "type": "table",
      "title": "Channel health now",
      "description": "Last five minutes of heartbeat activity by selected channel, platform and CDN.",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "${DS_CLICKHOUSE}"
      },
      "gridPos": {
        "h": 9,
        "w": 24,
        "x": 0,
        "y": 32
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "displayMode": "auto"
          }
        },
        "overrides": []
      },
      "options": {
        "footer": {
          "show": false
        },
        "showHeader": true
      },
      "targets": [
        {
          "refId": "A",
          "database": "analytics",
          "format": "table",
          "rawSql": "SELECT content_id, platform, cdn, country_code, uniqExact(session_id) AS viewers, round(avg(current_bitrate_kbps) / 1000, 3) AS bitrate_mbps, round(avg(buffer_length_s), 2) AS buffer_s, round(avg(live_latency_s), 2) AS latency_s FROM analytics_heartbeats WHERE event_minute >= now() - INTERVAL 5 MINUTE AND ('${content_id}' = 'ALL' OR content_id = '${content_id}') AND ('${platform}' = 'ALL' OR platform = '${platform}') GROUP BY content_id, platform, cdn, country_code ORDER BY viewers DESC"
        }
      ]
    },
    {
      "id": 14,
      "type": "table",
      "title": "Latest sessions",
      "description": "Most recent completed sessions with key QoE metrics.",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "${DS_CLICKHOUSE}"
      },
      "gridPos": {
        "h": 9,
        "w": 24,
        "x": 0,
        "y": 41
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "displayMode": "auto"
          }
        },
        "overrides": []
      },
      "options": {
        "footer": {
          "show": false
        },
        "showHeader": true
      },
      "targets": [
        {
          "refId": "A",
          "database": "analytics",
          "format": "table",
          "rawSql": "SELECT session_id, content_title, platform, device_os, country_code, round(startup_time_ms, 0) AS startup_ms, round(rebuffer_time_s, 2) AS rebuffer_s, rebuffer_count, round(avg_throughput_kbps / 1000, 3) AS throughput_mbps, session_end_reason FROM analytics_sessions WHERE session_date BETWEEN toDate($__fromTime) AND toDate($__toTime) AND content_type = 'live' AND ('${content_id}' = 'ALL' OR content_id = '${content_id}') ORDER BY session_end_ts DESC LIMIT 50"
        }
      ]
    }
  ],
  "refresh": "15s",
  "schemaVersion": 39,
  "tags": [
    "video",
    "live",
    "qoe",
    "operations",
    "clickhouse"
  ],
