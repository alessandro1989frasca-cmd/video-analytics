          },
          {
            "selected": false,
            "text": "smart_tv",
            "value": "smart_tv"
          }
        ]
      }
    ]
  },
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": [
      "15s",
      "30s",
      "1m",
      "5m"
    ],
    "time_options": [
      "5m",
      "15m",
      "30m",
      "1h",
      "6h",
      "12h",
      "24h"
    ]
  },
  "timezone": "browser",
  "title": "Live QoE Command Center",
  "uid": "live-qoe-command-center",
  "version": 1
}