{
  "__inputs": [
    {
      "name": "DS_CLICKHOUSE",
      "label": "ClickHouse Analytics",
      "type": "datasource",
      "pluginId": "grafana-clickhouse-datasource",
      "pluginName": "ClickHouse"
    }
  ],
  "__requires": [
    {
      "type": "grafana",
      "id": "grafana",
      "name": "Grafana",
      "version": "10.0.0"
    },
    {
      "type": "datasource",
      "id": "grafana-clickhouse-datasource",
      "name": "ClickHouse",
      "version": "4.0.0"
    }
  ],
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "editable": true,
  "graphTooltip": 1,
  "links": [],
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Event volume",
      "description": "Analytics events received over time.",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "${DS_CLICKHOUSE}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "min": 0,
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "database": "analytics",
          "format": "time_series",
          "rawSql": "SELECT toStartOfMinute(toDateTime(intDiv(received_at, 1000))) AS time, count() AS events FROM analytics_events WHERE received_at BETWEEN toUnixTimestamp(toDateTime($__timeFrom)) * 1000 AND toUnixTimestamp(toDateTime($__timeTo)) * 1000 GROUP BY time ORDER BY time"
        }
      ]
    },
    {
      "id": 2,
      "type": "barchart",
      "title": "Events by selected channel",
      "description": "The selected channel label is preserved in analytics. The current technical stream is RAI News for all buttons.",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "${DS_CLICKHOUSE}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "showValue": "auto",
        "legend": {
          "displayMode": "hidden"
        }
      },
      "targets": [
        {
          "refId": "A",
          "database": "analytics",
          "format": "table",
          "rawSql": "SELECT content_title, count() AS events FROM analytics_events WHERE received_at BETWEEN toUnixTimestamp(toDateTime($__timeFrom)) * 1000 AND toUnixTimestamp(toDateTime($__timeTo)) * 1000 GROUP BY content_title ORDER BY events DESC"
        }
      ]
    },
    {
      "id": 3,
      "type": "table",
      "title": "Sessions by channel",
      "description": "Completed sessions. A session appears here after Stop/session end.",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "${DS_CLICKHOUSE}"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "displayMode": "auto"
          }
        },
        "overrides": []
      },
      "options": {
        "footer": {
          "show": false
        },
        "showHeader": true
      },
      "targets": [
        {
          "refId": "A",
          "database": "analytics",
          "format": "table",
          "rawSql": "SELECT content_id, content_title, count() AS sessions, uniqExact(viewer_id) AS viewers, round(avg(startup_time_ms), 0) AS avg_startup_ms, round(100 * sum(rebuffer_time_s) / nullIf(sum(watch_time_s), 0), 3) AS rebuffer_ratio_pct, round(avg(avg_throughput_kbps) / 1000, 3) AS avg_throughput_mbps FROM analytics_sessions WHERE session_date BETWEEN toDate($__timeFrom) AND toDate($__timeTo) GROUP BY content_id, content_title ORDER BY sessions DESC"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Bitrate and bandwidth",
      "description": "Average player bitrate and bandwidth estimate in Mbps.",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "${DS_CLICKHOUSE}"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "unit": "Mbps"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "database": "analytics",
          "format": "time_series",
          "rawSql": "SELECT event_minute AS time, round(avg(current_bitrate_kbps) / 1000, 3) AS bitrate_mbps, round(avg(bandwidth_estimate_kbps) / 1000, 3) AS bandwidth_mbps FROM analytics_heartbeats WHERE event_minute BETWEEN toDateTime($__timeFrom) AND toDateTime($__timeTo) GROUP BY event_minute ORDER BY event_minute"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Errors over time",
      "description": "Errors grouped by source and code.",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "${DS_CLICKHOUSE}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 17
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "min": 0,
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "database": "analytics",
          "format": "time_series",
          "rawSql": "SELECT toStartOfMinute(toDateTime(intDiv(timestamp, 1000))) AS time, concat(error_source, ': ', error_code) AS error, count() AS errors FROM analytics_errors WHERE timestamp BETWEEN toUnixTimestamp(toDateTime($__timeFrom)) * 1000 AND toUnixTimestamp(toDateTime($__timeTo)) * 1000 GROUP BY time, error ORDER BY time"
        }
      ]
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Completed sessions",
      "description": "Sessions with a SESSION_END event in the selected time range.",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "${DS_CLICKHOUSE}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 17
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "blue",
                "value": 1
              }
            ]
          },
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "database": "analytics",
          "format": "table",
          "rawSql": "SELECT count() AS sessions FROM analytics_sessions WHERE session_date BETWEEN toDate($__timeFrom) AND toDate($__timeTo)"
        }
      ]
    }
  ],
  "refresh": "30s",
  "schemaVersion": 39,
  "tags": [
    "video",
    "qoe",
    "cdn",
    "clickhouse"
  ],
  "templating": {
    "list": []
  },
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": [
      "30s",
      "1m",
      "5m",
      "15m"
    ],
    "time_options": [
      "5m",
      "15m",
      "30m",
      "1h",
      "6h",
      "12h",
      "24h",
      "7d"
    ]
  },
  "timezone": "browser",
  "title": "Video QoE Analytics",
  "uid": "video-qoe-analytics",
  "version": 1
}